{
  "name": "today-progress-g1",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File install/bootstrap.ps1 -ExistingAccounts",
    "test:setup:db": "node tests/integration/existing-accounts.mjs",
    "dev": "vite",
    "build": "node scripts/build/build-production.mjs",
    "package:target": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-target-kit.ps1",
    "host": "node server/app/server.mjs --config config/development.json",
    "host:funnel": "node server/app/server.mjs --config config/local/funnel.host.json",
    "funnel": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File install/tailscale-funnel.ps1",
    "test:g2:lifecycle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/integration/lifecycle.ps1",
    "db:preflight": "node db/operations/preflight.mjs",
    "db:migrate": "node db/operations/migrate.mjs",
    "db:build-baseline": "node db/operations/build-baseline.mjs",
    "db:integrity": "node db/operations/integrity.mjs",
    "push:generate-vapid": "node db/operations/generate-vapid.mjs",
    "push:diagnostics": "node db/operations/push-diagnostics.mjs",
    "sessions:revoke": "node db/operations/sessions.mjs",
    "developer:setup": "node db/operations/developer-admin.mjs --config config/local/developer-admin.json",
    "test:db": "node tests/integration/database.mjs",
    "test:restore": "node tests/integration/restore-database.mjs",
    "soak:g2": "node tests/integration/soak.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "recovery:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File install/recovery.ps1 -Mode status",
    "recovery:set": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File install/recovery.ps1 -Mode set",
    "setup:target": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File install/target-environment.ps1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "mysql2": "^3.24.3",
    "web-push": "^3.6.7"
  }
}
