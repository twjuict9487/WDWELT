{
  "port": 8080,
  "bindAddress": "127.0.0.1",
  "canonicalHost": "127.0.0.1",
  "canonicalUrl": "http://127.0.0.1:8080",
  "installPath": "..",
  "currentPath": "../dist",
  "logPath": "../runtime/logs",
  "runPath": "../runtime/run",
  "backupPath": "../runtime/backups",
  "databaseConfigPath": "local/database.runtime.json",
  "adminDatabaseConfigPath": "local/database.admin.json",
  "mysqlServiceName": "MySQL80",
  "healthIntervalSeconds": 60,
  "healthTimeoutSeconds": 5,
  "healthFailureThreshold": 3,
  "recoveryCooldownSeconds": 120,
  "maintenanceLockMinutes": 15,
  "logRetentionDays": 14,
  "logMaxBytes": 5000000
}
